# ==============================================================================
# HealerJi — environment
# ------------------------------------------------------------------------------
# Anything prefixed NEXT_PUBLIC_ is inlined into the JavaScript bundle and is
# readable by anyone who visits the site. Everything else is server-only and
# must never gain that prefix.
#
# On Vercel: Project → Settings → Environment Variables. Set the server-only
# values for Production and Preview separately; do not reuse live keys in
# Preview.
# ==============================================================================

# ---------------------------------------------------------------- Supabase ---
# URL and anon key are public by design — every query they make is still
# subject to Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses Row Level Security completely. Treat as a root
# password: never prefix with NEXT_PUBLIC_, never commit, rotate if exposed.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- Razorpay ---
# The key id is safe in the browser (Checkout needs it) but is published under
# its own NEXT_PUBLIC_ name rather than by leaking the server variable.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
# SERVER ONLY — signs and verifies payments.
RAZORPAY_KEY_SECRET=
# SERVER ONLY — verifies webhook authenticity.
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------- Email ---
# SERVER ONLY.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_SUPPORT_INBOX=

# -------------------------------------------------------------- Cloudinary ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# SERVER ONLY — signed uploads and deletions.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Unsigned preset name, if you use client-side upload widgets.
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# --------------------------------------------------------- Google sign-in ---
# Authentication only. Distinct from Google Analytics (requirement 55).
# Also enable the provider in Supabase Dashboard → Authentication → Providers
# and add https://<your-domain>/auth/callback as an authorised redirect URI.
# Scopes requested: openid email profile. Nothing further.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---------------------------------------------------- Google Analytics (opt) ---
# A second analytics source. HealerJi's own events do not depend on it, and a
# booking is recorded in our database whether or not this is set.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ----------------------------------------------------- Google Search Console ---
# Site ownership / SEO verification only. Not auth, not analytics.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --------------------------------------------------------------- Analytics ---
# SERVER ONLY. Salts the daily rotating visitor hash so no raw IP is stored.
# Generate with: openssl rand -hex 32
ANALYTICS_SALT=

# ------------------------------------------------------------------- Site ---
# OPTIONAL OVERRIDE. lib/site-url.ts builds invitation, password-reset and
# OAuth redirect URLs from the incoming request, which is already correct on
# Vercel for both production and preview deployments. Set this only to pin a
# custom domain — and if you set it, set it to the domain that actually serves
# the app, because every emailed link will point there.
#   Current production deployment: https://healerji.vercel.app
NEXT_PUBLIC_SITE_URL=

# ==============================================================================
# REMOVED
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_FIREBASE_API_KEY
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN
# NEXT_PUBLIC_FIREBASE_PROJECT_ID
#   Firebase was declared but imported nowhere in the codebase. Supabase Auth
#   is the authentication system; running two would mean two sources of truth
#   for who a person is. The dependency has been removed from package.json.
# ==============================================================================
