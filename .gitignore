# ==============================================================================
# HealerJi — .gitignore
# ------------------------------------------------------------------------------
# This file was MISSING until pass 5. Without it, `git add .` after an
# `npm install` would commit node_modules, and — far worse — any .env.local
# holding the Supabase service-role key, the Razorpay secret or the Cloudinary
# secret. Those are the credentials that bypass Row Level Security and move
# money. Nothing below is optional.
# ==============================================================================

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/versions

# next.js
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# ---------------------------------------------------------------- SECRETS ----
# .env.example is the only env file that belongs in git. It contains names and
# empty placeholders, never values.
.env
.env.*
!.env.example

# supabase CLI local state — contains a generated local service-role key
/supabase/.branches
/supabase/.temp
/supabase/.env

# vercel
.vercel

# testing / coverage
/coverage
/.nyc_output

# editors and OS noise
.DS_Store
*.pem
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local scratch
/tmp
*.local
